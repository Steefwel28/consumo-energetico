    <!-- Cápsulas educativas -->
    <string name="capsule_seer_title">SEER: frío con menos watts</string>
    <string name="capsule_seer_body">Un SEER alto entrega el mismo frío con menos electricidad. Es el número que de verdad mueve tu factura, no solo el BTU/h.</string>
    <string name="capsule_myth_title">El mito de los 17 °C</string>
    <string name="capsule_myth_body">Cada grado bajo 24 °C cuesta cerca de 6 %% más. El cuarto se siente igual con ventilador de techo; el compresor no necesita pelear con el termostato.</string>
    <string name="capsule_small_title">La trampa del aire pequeño</string>
    <string name="capsule_small_body">Un equipo subdimensionado trabaja al 100 % sin modular, gasta más y se desgasta antes. Compra el escalón que cubre el metraje real.</string>
    <string name="capsule_protector_title">Protector Inverter y julios</string>
    <string name="capsule_protector_body">En Inverter el protector va en línea directa (borneras): AVTEK SPC-PEBAS-B230 de 2,100 J o Forza FVP-6630B de 880 J. Sin él, un pico quema la tarjeta.</string>
    <string name="capsule_dry_title">Modo Dry vs. deshumidificador</string>
    <string name="capsule_dry_body">El Modo Dry baja la humedad sin forzar el compresor como el frío. El deshumidificador ayuda, pero consume aparte y hay que vaciarle el tanque.</string>

